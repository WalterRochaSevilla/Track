{
  "name": "mcp-server-cochatech",
  "version": "1.0.0",
  "description": "MCP Server modular para el Track MCPJam",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "generate-env": "tsx scripts/generateEnv.ts",
    "prebuild": "npm run generate-env",
    "build": "tsc",
    "start": "node build/index.js",
    "start:http": "node build/index.js",
    "dev:http": "node --watch build/index.js",
    "dev:inspector": "npm run build && node -e \"const p = require('path'); require('child_process').execSync('npx -y @mcpjam/inspector@latest \\\"node ' + p.join(process.cwd(), 'build/index.js').split(p.sep).join('/') + '\\\"', {stdio: 'inherit'});\"",
    "dev:mcp-inspector": "npx -y @mcpjam/inspector@latest node $(pwd)/build/server.js",
    "generate:tool": "node scripts/generateTool.js",
    "evals": "tsx scripts/runEvals.ts",
    "evals:real": "tsx scripts/runEvalsReal.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "axios": "^1.6.8",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "json-2-csv": "^5.5.11",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.11.5",
    "postgres": "^3.4.9",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
